/* カラオケAPP 共通スタイルシート(雛形)
   各コンポーネントの _apply_style() から読み込んで使用する想定 */

QWidget#HeaderWidget {
    background-color: #1f1f2e;
}

QPushButton#PrimaryButton {
    background-color: #ff4d6d;
    color: white;
    border-radius: 6px;
    padding: 8px 16px;
}

QPushButton#SecondaryButton {
    background-color: #3a3a4d;
    color: white;
    border-radius: 6px;
    padding: 8px 16px;
}
