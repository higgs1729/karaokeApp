/* ===== Global ===== */
QWidget {
    background-color: #1a1a2e;
    color: #e0e0e0;
    font-family: "Noto Sans JP", "Yu Gothic", sans-serif;
    font-size: 14px;
}

/* ===== Header ===== */
#HeaderWidget {
    background-color: #16213e;
    border-bottom: 2px solid #e94560;
}

#AppTitle {
    color: #e94560;
    font-size: 24px;
    font-weight: bold;
}

/* ===== Buttons ===== */
#PrimaryButton {
    background-color: #e94560;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: bold;
}

#PrimaryButton:hover {
    background-color: #c73652;
}

#PrimaryButton:pressed {
    background-color: #a52b42;
}

#SecondaryButton {
    background-color: #0f3460;
    color: #e0e0e0;
    border: 1px solid #e94560;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}

#SecondaryButton:hover {
    background-color: #1a4a7a;
}

/* ===== Inputs ===== */
#TextInput {
    background-color: #16213e;
    border: 1px solid #0f3460;
    border-radius: 6px;
    padding: 8px 12px;
    color: #e0e0e0;
    font-size: 14px;
}

#TextInput:focus {
    border-color: #e94560;
}

/* ===== Cards ===== */
#CardWidget {
    background-color: #16213e;
    border: 1px solid #0f3460;
    border-radius: 10px;
}

/* ===== Lists ===== */
QListWidget {
    background-color: #16213e;
    border: 1px solid #0f3460;
    border-radius: 6px;
}

QListWidget::item:selected {
    background-color: #e94560;
    color: #ffffff;
}

QListWidget::item:hover {
    background-color: #0f3460;
}

/* ===== Sliders ===== */
QSlider::groove:horizontal {
    height: 6px;
    background: #0f3460;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #e94560;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::sub-page:horizontal {
    background: #e94560;
    border-radius: 3px;
}

/* ===== Tabs ===== */
QTabWidget::pane {
    border: 1px solid #0f3460;
}

QTabBar::tab {
    background: #0f3460;
    color: #e0e0e0;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background: #e94560;
    color: #ffffff;
}

/* ===== Lyrics ===== */
#LyricsLabel {
    font-size: 22px;
    color: #ffffff;
    background: transparent;
}
